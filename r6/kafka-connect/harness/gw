#!/usr/bin/env bash
# ./gradlew with a JDK found for you. Equivalent to exporting JAVA_HOME and calling ./gradlew.
set -euo pipefail
cd "$(dirname "$0")"
if [ -z "${JAVA_HOME:-}" ]; then
  for candidate in \
      "$(/usr/libexec/java_home -v 21 2>/dev/null || true)" \
      /Users/I074560/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home \
      /opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home \
      /usr/lib/jvm/java-21-openjdk; do
    if [ -n "$candidate" ] && [ -x "$candidate/bin/java" ]; then
      JAVA_HOME="$candidate"
      break
    fi
  done
fi
if [ -z "${JAVA_HOME:-}" ]; then
  echo "No JDK 17+ found. Set JAVA_HOME and try again." >&2
  exit 1
fi
export JAVA_HOME
export PATH="$JAVA_HOME/bin:$PATH"
exec ./gradlew "$@"
